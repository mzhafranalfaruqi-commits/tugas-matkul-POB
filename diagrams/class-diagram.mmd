classDiagram
    %% ========================================================================
    %% SEVIMA-Mini Class Diagram (Minggu 2 - Refinement SOLID & Design Patterns)
    %% Refactored from God Object SistemAkademik -> Modular Services, ISP, DIP,
    %% Strategy (ValidationRule), Factory (UserFactory), Observer (KRSEventBus)
    %% ========================================================================

    %% --- 1. Hierarki User & Interface Segregation Principle (ISP) ---
    class PengisiKRS {
        <<interface>>
        +ajukanKRS(krs) bool
    }

    class PenyetujuKRS {
        <<interface>>
        +setujuiKRS(krs) bool
        +revisiKRS(krs, catatan) bool
    }

    class Penilai {
        <<interface>>
        +inputNilai(enrollId, angka) Grade
    }

    class User {
        <<abstract>>
        #int id
        #String username
        -String passwordHash
        #String namaLengkap
        #String email
        #bool isActive
        +login(username, password) bool
        +logout() void
        +getPeran()* String
    }

    class CalonMahasiswa {
        -String noPendaftaran
        -String jalurMasuk
        -String statusSeleksi
        -bool berkasLengkap
        +unggahBerkas(jenis, path) bool
        +cekStatusSeleksi() String
        +getPeran() String
    }

    class Mahasiswa {
        -String nim
        -int tahunMasuk
        -Decimal ipk
        -String statusAktif
        +getIPK() Decimal
        +ajukanKRS(krs) bool
        +lihatTranskrip() String
        +getPeran() String
    }

    class Dosen {
        -String nidn
        -String jabatanFungsional
        -int kuotaBimbingan
        +setujuiKRS(krs) bool
        +revisiKRS(krs, catatan) bool
        +inputNilai(enrollId, angka) Grade
        +bukaSesiPresensi(jadwalId, durasi) String
        +getPeran() String
    }

    class Admin {
        -String kodeAdmin
        -String unitKerja
        +kelolaMasterData(entitas, aksi) bool
        +terbitkanTagihanSPP(nim, semester) Payment
        +auditLogAkses() List~String~
        +getPeran() String
    }

    %% --- 2. Core Academic Entities & Lifecycle Ownership ---
    class ProgramStudi {
        -String kodeProdi
        -String namaProdi
        -String jenjang
        -int maxSKSDefault
        +hitungMaxSKSDariIPK(ipk) int
        +tambahKurikulum(course) void
        +cekKuotaProdi(kodeProdi) bool
    }

    class Course {
        -String kodeMK
        -String namaMK
        -int sks
        -int semesterRekomendasi
        +getDetailMK() String
        +cekPrasyarat(kodeLulus) bool
    }

    class KRS {
        -int id
        -String semester
        -String status
        -int totalSKS
        -int version
        -DateTime submittedAt
        +hitungTotalSKS() int
        +ubahStatus(statusBaru) void
        +tambahItem(enrollment) void
    }

    class Enrollment {
        -int id
        -String statusPresensi
        -int totalHadir
        -int totalPertemuan
        +catatKehadiran(tokenQR, waktu) bool
        +hitungPersentaseHadir() Decimal
        +cekPesertaAktif(nim, jadwalId) bool
    }

    class Schedule {
        -int id
        -String hari
        -Time jamMulai
        -Time jamSelesai
        -String ruang
        -int kuotaMaks
        -String tokenQRAktif
        +terapkanTokenQR(durasiMenit) String
        +cekBentrokWaktu(lain) bool
        +cocokkanTokenQR(jti, waktu) bool
        +sisaKuota() int
    }

    class Grade {
        -int id
        -Decimal nilaiAngka
        -String nilaiHuruf
        -Decimal bobot
        -bool isFinal
        +konversiHuruf(angka) String
        +hitungBobot() Decimal
    }

    class Payment {
        -int id
        -String nomorTagihan
        -Decimal nominal
        -Decimal denda
        -String statusBayar
        -Date jatuhTempo
        +prosesPembayaran(metode, jumlah) bool
        +hitungDendaKeterlambatan(hariTerlambat) Decimal
        +isLunas() bool
    }

    %% --- 3. Strategy Pattern: KRS Validation Rules (OCP) ---
    class ValidationRule {
        <<interface>>
        +validate(krs, repo) String
    }

    class PrasyaratRule {
        -String namaAturan
        +validate(krs, repo) String
    }

    class BatasSKSRule {
        -int batasDefault
        +validate(krs, repo) String
    }

    class BentrokJadwalRule {
        -String namaAturan
        +validate(krs, repo) String
    }

    class KuotaKelasRule {
        -String namaAturan
        +validate(krs, repo) String
    }

    class StatusPembayaranRule {
        -String namaAturan
        +validate(krs, repo) String
    }

    class KRSValidator {
        -List~ValidationRule~ rules
        +validasi(krs, repo) List~String~
        +validasiStatusSPP(payment) bool
        +validasiBatasSKS(totalSKS, maksSKS) bool
        +cekJadwalBentrok(daftarJadwal) List~String~
        +tambahAturan(rule) void
    }

    %% --- 4. Dependency Inversion (DIP), Factory, Modular Services & Observer ---
    class KRSRepository {
        <<interface>>
        +getKRS(nim, semester) KRS
        +cekPrasyaratLulus(nim, kodeMK) bool
        +simpanKRS(krs) void
    }

    class PostgresKRSRepository {
        -String dsn
        +getKRS(nim, semester) KRS
        +cekPrasyaratLulus(nim, kodeMK) bool
        +simpanKRS(krs) void
    }

    class UserFactory {
        -String prefixNIM
        +buat(peran, data) User
        +generateNIM(tahun, kodeProdi) String
    }

    class NotificationObserver {
        <<interface>>
        +update(event, penerima, pesan) void
    }

    class EmailNotifier {
        -String smtpHost
        +update(event, penerima, pesan) void
    }

    class WhatsAppNotifier {
        -String gatewayUrl
        +update(event, penerima, pesan) void
    }

    class KRSEventBus {
        -List~NotificationObserver~ subscribers
        +subscribe(observer) void
        +unsubscribe(observer) void
        +publish(event, penerima, pesan) void
    }

    class NotificationService {
        -KRSEventBus eventBus
        -int maxRetry
        +kirimNotifAsync(event, penerima, pesan) void
        +antrekanRetry(payload) void
    }

    class SistemPMB {
        -UserFactory userFactory
        -NotificationService notifService
        +daftarCalon(dataPendaftar, berkas) CalonMahasiswa
        +verifikasiBerkas(noPendaftaran) bool
        +prosesKelulusanPMB(noPendaftaran, kodeProdi) Mahasiswa
    }

    class KRSManager {
        -KRSValidator validator
        -KRSRepository krsRepo
        -NotificationService notifService
        +ajukanKRS(pelaku, krs) String
        +prosesApprovalPA(dosen, krsId, keputusan, catatan) String
    }

    class JadwalService {
        -int semesterAktif
        +buatJadwalKuliah(kodeMK, nidn, slot) Schedule
        +cekKonflikDosenRuang(nidn, ruang, slot) bool
    }

    class KeuanganService {
        -NotificationService notifService
        +cekStatusSPP(nim, semester) bool
        +verifikasiPembayaran(nomorTagihan, metode) bool
    }

    class PresensiService {
        -NotificationService notifService
        +bukaQRPresensi(dosen, jadwalId, durasi) String
        +scanQRPresensi(nim, tokenQR) bool
    }

    %% --- 5. Relasi Terarah Tanpa Siklus (Strict DAG) ---
    User <|-- CalonMahasiswa
    User <|-- Mahasiswa
    User <|-- Dosen
    User <|-- Admin

    PengisiKRS <|.. Mahasiswa
    PenyetujuKRS <|.. Dosen
    Penilai <|.. Dosen

    ProgramStudi "1" o-- "0..*" Mahasiswa : memiliki
    ProgramStudi "1" o-- "1..*" Dosen : menaungi
    ProgramStudi "1" *-- "1..*" Course : menyusunKurikulum

    Course "0..*" --> "0..*" Course : prasyarat
    Course "1" *-- "1..*" Schedule : dijadwalkanPada

    Mahasiswa "1" --> "0..*" KRS : mengajukan
    Mahasiswa "1" --> "0..*" Payment : ditagihkan
    KRS "1" *-- "1..*" Enrollment : berisi
    Enrollment "1" *-- "0..1" Grade : menghasilkan
    Schedule "1" <-- "0..*" Enrollment : terdaftarDi
    Dosen "1" --> "0..*" Schedule : mengampu

    ValidationRule <|.. PrasyaratRule
    ValidationRule <|.. BatasSKSRule
    ValidationRule <|.. BentrokJadwalRule
    ValidationRule <|.. KuotaKelasRule
    ValidationRule <|.. StatusPembayaranRule

    PrasyaratRule ..> Course : cekPrasyarat
    BentrokJadwalRule ..> Schedule : cekKonflik
    StatusPembayaranRule ..> Payment : cekLunas

    KRSValidator "1" o-- "1..*" ValidationRule : menerapkan
    KRSValidator ..> KRSRepository : bacaPrasyarat
    KRSValidator ..> KRS : memvalidasi

    KRSRepository <|.. PostgresKRSRepository
    KRSRepository ..> KRS : persistensi

    KRSEventBus "1" o-- "1..*" NotificationObserver : subscribers
    NotificationObserver <|.. EmailNotifier
    NotificationObserver <|.. WhatsAppNotifier
    NotificationService "1" *-- "1" KRSEventBus : delegasiEvent

    UserFactory ..> User : memproduksi
    UserFactory ..> Mahasiswa : instansiasi
    UserFactory ..> CalonMahasiswa : instansiasi
    UserFactory ..> Dosen : instansiasi
    UserFactory ..> Admin : instansiasi

    SistemPMB "1" --> "1" UserFactory : buatAkun
    SistemPMB ..> ProgramStudi : validasiProdi
    SistemPMB ..> NotificationService : kirimAsync

    KRSManager "1" --> "1" KRSValidator : validasiDengan
    KRSManager "1" --> "1" KRSRepository : dipInject
    KRSManager ..> PengisiKRS : menerimaAktor
    KRSManager ..> PenyetujuKRS : approvalOleh
    KRSManager ..> KRS : kelolaStatus
    KRSManager ..> NotificationService : kirimAsync

    JadwalService ..> Course : bacaMK
    JadwalService ..> Schedule : buatJadwal
    JadwalService ..> Dosen : tetapkanPengampu

    KeuanganService ..> Payment : verifikasiBayar
    KeuanganService ..> Mahasiswa : cekTagihan
    KeuanganService ..> NotificationService : kirimAsync

    PresensiService ..> Schedule : kelolaQR
    PresensiService ..> Enrollment : catatHadir
    PresensiService ..> Dosen : validasiSesi
    PresensiService ..> NotificationService : kirimAsync
