%% Sequence Diagram 2 — Validasi KRS (KRSValidator, KRSRepository, Loop, Self-Call, Async)
%% Mencakup rantai aturan OOP/OCP, loop prasyarat, error spesifik collect-all, & review PA

sequenceDiagram
    autonumber
    actor Mhs as Mahasiswa
    participant KM as KRSManager
    participant KV as KRSValidator
    participant Repo as KRSRepository
    participant Notif as NotificationService
    actor PA as Dosen

    Mhs->>+KM: ajukanKRS(Mhs, krs, expectedVersion)
    KM->>+Repo: getKRS(nim, semester)
    Repo-->>-KM: objek KRS + daftar Enrollment + status Payment

    KM->>+KV: validasi(krs, Repo)
    KV->>KV: validasiStatusSPP(payment)

    loop Setiap mata kuliah di KRS
        KV->>+Repo: cekPrasyaratLulus(nim, kodeMK)
        Repo-->>-KV: statusPrasyarat (bobot >= 2.0)
    end

    KV->>KV: validasiBatasSKS(totalSKS, 24)
    KV->>KV: cekJadwalBentrok(daftarJadwal)
    KV-->>-KM: daftarError[] (hasil collect-all)

    alt Daftar error tidak kosong (gagal validasi)
        Note over KM,KV: Error spesifik collect-all: tunggakan SPP, prasyarat IF101, SKS 26 > 24, bentrok IF201 vs IF203
        KM-->>Mhs: HTTP 400/403 Gagal Validasi (daftar lengkap pesan error spesifik)
    else Semua validasi lolos (daftarError kosong)
        KM->>KM: ubahStatus(PENDING_APPROVAL)
        KM->>+Repo: simpanKRS(krs, expectedVersion)
        alt Konflik Optimistic Lock (expectedVersion usang)
            Repo-->>KM: StaleDataError (rollback)
            KM-->>Mhs: HTTP 409 Conflict (versi KRS berubah, muat ulang)
        else Simpan KRS sukses
            Repo-->>-KM: committed (version + 1)
            KM-)Notif: kirimNotifAsync("KRS_SUBMITTED", PA, nim)
            Notif-)PA: Email/Push: KRS mahasiswa menunggu approval PA
            KM-->>-Mhs: HTTP 200 OK (status=PENDING_APPROVAL)
        end
    end

    %% Alur Lanjutan Dosen PA (Approve KRS atau Ajukan Revisi KRS)
    opt Review KRS oleh Dosen PA
        PA->>+KM: prosesApprovalPA(PA, krsId, keputusan, catatan)
        KM->>+Repo: getKRS(krsId, semester)
        Repo-->>-KM: objek KRS + verifikasi PA

        alt Bukan Dosen PA mahasiswa bersangkutan
            KM-->>PA: HTTP 403 Forbidden (bukan Dosen PA sah)
        else Disetujui oleh Dosen PA (APPROVED)
            KM->>KM: ubahStatus(APPROVED)
            KM->>+Repo: simpanKRS(krs)
            Repo-->>-KM: committed
            KM-)Notif: kirimNotifAsync("KRS_APPROVED", Mhs, krsId)
            Notif-)Mhs: Push/Email: KRS disetujui (APPROVED)
            KM-->>PA: HTTP 200 OK (status=APPROVED)
        else Diminta revisi oleh Dosen PA (REVISION)
            KM->>KM: ubahStatus(REVISION)
            KM->>+Repo: simpanKRS(krs, catatan)
            Repo-->>-KM: committed
            KM-)Notif: kirimNotifAsync("KRS_REVISION", Mhs, catatan)
            Notif-)Mhs: Email/Push: Revisi KRS diperlukan (+ catatan PA)
            KM-->>-PA: HTTP 200 OK (status=REVISION)
        end
    end
