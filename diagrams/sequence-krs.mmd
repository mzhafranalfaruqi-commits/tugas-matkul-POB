%% Sequence Diagram 2 — Validasi KRS dengan Pengecekan Prasyarat, SKS, & Bentrok
%% Mencakup rantai ValidationRule (CoR), optimistic lock, alternate flow error, & approval Dosen PA

sequenceDiagram
    autonumber
    actor Mhs as Mahasiswa
    participant KM as KRSManager
    participant VR as ValidationRule Chain
    participant DB as Database
    participant Notif as NotificationService
    actor PA as Dosen PA

    Mhs->>+KM: submitKRS(nim, semester, expectedVersion)
    KM->>+DB: beginTransaction() & ambilKRS(nim, semester)
    DB-->>KM: objek KRS + daftar Enrollment + status Payment

    alt Mahasiswa memiliki tunggakan SPP overdue/unpaid
        KM->>VR: BillingArrearsRule.validate(krs, course)
        VR-->>KM: gagal (Tunggakan SPP belum lunas)
        KM->>DB: rollback()
        KM-->>Mhs: HTTP 403 Forbidden (KRS diblokir tunggakan SPP)
    else Bebas tunggakan SPP -> jalankan rantai validasi KRS
        KM->>+VR: DuplicateEnrollmentRule.validate(krs, course)
        VR-->>KM: hasil cek duplikasi MK
        KM->>VR: PrerequisiteValidationRule.validate(krs, course)
        VR->>DB: query NOT EXISTS prasyarat lulus (bobot >= 2.0) semester lalu
        DB-->>VR: daftar prasyarat belum lulus
        KM->>VR: SKSValidationRule.validate(krs, course)
        VR-->>KM: cek totalSks <= 24
        KM->>VR: ScheduleConflictRule.validate(krs, course)
        VR-->>-KM: cek irisan interval [jamMulai, jamSelesai) pada hari sama

        alt Validasi gagal (prasyarat belum lulus / SKS > 24 / jadwal bentrok)
            KM->>DB: rollback()
            KM-->>Mhs: HTTP 400 Bad Request (daftar seluruh error validasi)
        else Semua validasi lolos
            KM->>KM: ubahStatus(Pending Approval / SUBMITTED, Mahasiswa)
            KM->>DB: updateKRS(status=SUBMITTED, version+1) & insertLog(krs_log)
            alt Konflik versi optimistic lock atau status tidak sah
                DB-->>KM: StaleDataError / conflict
                KM->>DB: rollback()
                KM-->>Mhs: HTTP 409 Conflict (expectedVersion usang)
            else Commit sukses
                DB-->>-KM: committed
                KM->>+Notif: kirimNotifikasi(PA, krsMenungguPersetujuan, EMAIL)
                Notif-->>-KM: terkirim
                KM-->>-Mhs: HTTP 200 OK (status=Pending Approval)
            end
        end
    end

    %% Alur Lanjutan Dosen PA (Approve / Revisi)
    opt Review KRS oleh Dosen PA
        PA->>+KM: approveKRS(krs, dosen) atau reviseKRS(krs, dosen, catatan)
        KM->>+DB: beginTransaction() & cekOtorisasiPA(krs, dosen)
        alt Bukan Dosen PA mahasiswa bersangkutan
            KM->>DB: rollback()
            KM-->>PA: HTTP 403 Forbidden
        else Dosen PA terverifikasi & disetujui
            KM->>KM: ubahStatus(APPROVED, DosenPA)
            KM->>DB: updateKRS(APPROVED) + insertLog + commit()
            DB-->>KM: committed
            KM->>+Notif: kirimNotifikasi(Mhs, krsDisetujui, PUSH)
            Notif-->>-KM: terkirim
            KM-->>PA: HTTP 200 OK (APPROVED)
        else Dosen PA meminta revisi
            KM->>KM: ubahStatus(REVISION, DosenPA)
            KM->>DB: updateKRS(REVISION, catatan) + insertLog + commit()
            DB-->>-KM: committed
            KM->>+Notif: kirimNotifikasi(Mhs, catatanRevisi, EMAIL)
            Notif-->>-KM: terkirim
            KM-->>-PA: HTTP 200 OK (REVISION)
        end
    end
