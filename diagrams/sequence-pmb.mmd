%% Sequence Diagram 1 — Proses Pendaftaran Mahasiswa Baru (PMB) [Minggu 2]
%% Mencakup UserFactory, validasi berkas tidak lengkap, idempotency, retry email gagal, & async (-)

sequenceDiagram
    autonumber
    actor CM as CalonMahasiswa
    actor Adm as Admin
    participant PMB as SistemPMB
    participant Prodi as ProgramStudi
    participant UF as UserFactory
    participant Notif as NotificationService

    %% Tahap 1: Registrasi & Unggah Berkas Calon Mahasiswa
    CM->>+PMB: daftarCalon(dataPendaftar, berkas)
    PMB->>PMB: validasiBerkasDanFormat(email, prodi, berkas)
    alt Berkas tidak lengkap atau format input salah
        PMB-->>CM: HTTP 400 Bad Request (daftar berkas/field wajib kurang)
    else Email sudah terdaftar sebelumnya
        PMB-->>CM: HTTP 409 Conflict (email sudah terdaftar)
    else Data & berkas lengkap valid
        PMB->>PMB: simpanCalon(status=pending)
        PMB-->>-CM: HTTP 201 Created (noPendaftaran, status=pending)
    end

    %% Tahap 2: Verifikasi Admin, Factory NIM/Mahasiswa, & Fallback Notifikasi Async
    Adm->>+PMB: prosesKelulusanPMB(noPendaftaran, kodeProdi)
    PMB->>PMB: beginTransaction() & kunciData(noPendaftaran)

    alt Pendaftar tidak ditemukan
        PMB->>PMB: rollbackTransaksi()
        PMB-->>Adm: HTTP 404 Not Found
    else Berkas wajib belum terverifikasi atau belum lengkap
        PMB->>PMB: rollbackTransaksi()
        PMB-->>Adm: HTTP 400 Bad Request (berkas seleksi belum lengkap)
    else Status sudah approved (idempotent guard)
        PMB->>PMB: rollbackTransaksi()
        PMB-->>Adm: HTTP 200 OK (already_approved=true, nim)
    else Ditolak Admin (status=rejected)
        PMB->>PMB: updateStatus(rejected) & commitTransaksi()
        PMB-)Notif: kirimNotifAsync("PMB_REJECTED", CM, alasanPenolakan)
        Notif-)CM: Email pemberitahuan hasil seleksi PMB
        PMB-->>Adm: HTTP 200 OK (status=rejected)
    else Disetujui Admin (status=pending)
        PMB->>+Prodi: cekKuotaProdi(kodeProdi)
        Prodi-->>-PMB: ProgramStudi valid (kuota tersedia)
        PMB->>+UF: generateNIM(tahun, kodeProdi)
        alt Nomor urut tahunan melebihi 9999
            UF-->>PMB: ValueError (kuota counter NIM tahunan penuh)
            PMB->>PMB: rollbackTransaksi()
            PMB-->>Adm: HTTP 400 Bad Request
        else Nomor urut valid
            UF-->>-PMB: nimFormat (YYYYKKK-NNNN)
            PMB->>+UF: buat("mahasiswa", dataCalon)
            UF-->>-PMB: objek Mahasiswa baru (NIM = nimFormat)
            PMB->>PMB: commitTransaksiAtomik(calon=approved, mahasiswa)
            PMB-)Notif: kirimNotifAsync("PMB_APPROVED", CM, nimFormat)
            PMB-->>-Adm: HTTP 200 OK (nimFormat, status=approved)
            alt Pengiriman email SMTP berhasil
                Notif-)CM: Email aktivasi akun & NIM baru terkirim
            else Gateway email gagal / timeout
                Notif->>Notif: antrekanRetry(payload, backoff=eksponensial)
                Note right of Notif: Akun Mahasiswa & NIM tetap tersimpan (tidak di-rollback)
            end
        end
    end
