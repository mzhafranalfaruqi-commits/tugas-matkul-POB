%% Sequence Diagram 3 (Bonus) — Presensi Mahasiswa via Scan QR Code [Minggu 2]
%% Tersinkronisasi 100% dengan Dosen, Mahasiswa, PresensiService, Schedule, Enrollment, NotificationService

sequenceDiagram
    autonumber
    actor Dsn as Dosen
    actor Mhs as Mahasiswa
    participant PS as PresensiService
    participant Sch as Schedule
    participant Enr as Enrollment
    participant Notif as NotificationService

    %% Tahap 1: Dosen membuka sesi QR dinamis
    Dsn->>+PS: bukaQRPresensi(Dsn, jadwalId, 15)
    PS->>+Sch: terapkanTokenQR(15)
    Sch-->>-PS: tokenJWT (jti aktif, berlaku 15 menit)
    PS-->>-Dsn: QR Code Sesi Pertemuan

    %% Tahap 2: Mahasiswa melakukan scan QR & validasi multi-kondisi
    Mhs->>+PS: scanQRPresensi(nim, tokenJWT, lat, lng)
    PS->>PS: decodeDanCekJWT(tokenJWT, waktuSekarang)

    alt Token JWT tidak valid, dipalsukan, atau kedaluwarsa (> 15 menit)
        PS-->>Mhs: HTTP 401 Unauthorized (token QR tidak valid/expired)
    else Token JWT valid -> periksa Schedule & Enrollment
        PS->>+Sch: cocokkanTokenQR(jti, waktuSekarang)
        Sch-->>-PS: data jadwal aktif & status token
        PS->>+Enr: cekPesertaAktif(nim, jadwalId)
        Enr-->>-PS: statusEnrollment (APPROVED / hadir / duplikat)

        alt Mahasiswa bukan peserta kelas (KRS belum APPROVED)
            PS-->>Mhs: HTTP 403 Forbidden (bukan peserta mata kuliah)
        else Jti token usang (replay) atau di luar hari/jam jadwal
            PS-->>Mhs: HTTP 400 Bad Request (QR tidak sesuai jadwal hari ini)
        else Lokasi mahasiswa di luar radius geofence ruang kelas
            PS-->>Mhs: HTTP 400 Bad Request (di luar radius geofence kampus)
        else Sudah pernah mencatat presensi pada sesi ini
            PS-->>Mhs: HTTP 409 Conflict (presensi sesi ini sudah tercatat)
        else Lolos seluruh validasi (hadir <= 15 mnt / terlambat <= 30 mnt)
            PS->>+Enr: catatKehadiran(tokenJWT, waktuSekarang)
            Enr-->>-PS: kehadiran tersimpan & persentase terupdate
            PS-)Notif: kirimNotifAsync("PRESENSI_TERCATAT", Dsn, rekap)
            Notif-)Dsn: Push: Rekap kehadiran mahasiswa real-time
            PS-->>-Mhs: HTTP 200 OK (status=hadir/terlambat, tercatat)
        end
    end
